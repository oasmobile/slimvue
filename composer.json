{
    "name"       : "oasis/slimvue",
    "description": "Front-End lib & bootstrap project",
    "type"       : "library",
    "require"    : {
        "php"               : ">=8.5",
        "oasis/http"        : "^3.1",
        "oasis/utils"       : "^3.0",
        "symfony/console"   : "^8.0",
        "symfony/filesystem": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan"      : "^2.0",
        "phpunit/phpunit"      : "^13.0",
        "twig/twig"            : "^3.0",
        "giorgiosironi/eris"   : "~1.1"
    },
    "license"    : "MIT",
    "authors"    : [
        {
            "name" : "Minhao Zhang",
            "email": "minhao.zhang@qq.com"
        }
    ],
    "bin"        : [
        "bin/slimvue"
    ],
    "autoload"   : {
        "psr-4": {
            "Oasis\\SlimVue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oasis\\SlimVue\\Demo\\": "demo/",
            "Oasis\\SlimVue\\Tests\\": "tests/"
        }
    }
}
