{
    "name": "slimvue-template",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "serve": "vue-cli-service serve --mode serve",
        "build": "vue-cli-service build --mode development",
        "watch": "vue-cli-service build --mode development --watch",
        "release": "vue-cli-service build --modern",
        "lib": "vue-cli-service build --target lib --name $npm_package_name src/publish.js",
        "lint": "vue-cli-service lint",
        "inspect": "vue-cli-service inspect",
        "test": "jest --no-cache",
        "test:coverage": "jest --no-cache --coverage"
    },
    "dependencies": {
        "core-js": "^3.6.4",
        "vue": "^2.6.11"
    },
    "devDependencies": {
        "@vue/cli-plugin-babel": "^4.3.0",
        "@vue/cli-plugin-eslint": "^4.3.0",
        "@vue/cli-service": "^4.3.0",
        "@vue/eslint-config-prettier": "^6.0.0",
        "@vue/test-utils": "^1.3.6",
        "babel-core": "^7.0.0-bridge.0",
        "babel-eslint": "^10.1.0",
        "babel-jest": "^26.6.3",
        "eslint": "^6.7.2",
        "eslint-plugin-prettier": "^3.1.1",
        "eslint-plugin-vue": "^6.2.2",
        "jest": "^26.6.3",
        "prettier": "^1.19.1",
        "sass": "^1.26.3",
        "sass-loader": "^8.0.2",
        "vue-jest": "^3.0.7",
        "vue-template-compiler": "^2.6.11"
    }
}
