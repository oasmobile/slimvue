{
    "name": "slimvue-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "node scripts/check-node.js && vite build --mode development",
        "release": "node scripts/check-node.js && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "vue": "^3.5"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6",
        "@vue/test-utils": "^2.4",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "eslint-plugin-vue": "^10",
        "fast-check": "^4",
        "prettier": "^3.6",
        "sass": "^1.92",
        "vite": "^7",
        "vitest": "^3"
    }
}
